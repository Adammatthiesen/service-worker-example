# Environment variables for Astro Push Notifications CMS
# Copy this file to .env and fill in your values

# ========================================
# VAPID Keys (Web Push Authentication)
# ========================================
# Generate with: npm run generate-vapid
VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here
VAPID_SUBJECT=mailto:your-email@example.com

# ========================================
# AstroDB Configuration
# ========================================
# Optional: For production remote database (e.g., Turso)
# Leave empty for local development
# ASTRO_DB_REMOTE_URL=libsql://your-db.turso.io
# ASTRO_DB_APP_TOKEN=your-token-here

# ========================================
# Authentication (optional overrides)
# ========================================
# SESSION_SECRET=your-random-secret-key-here
# SESSION_EXPIRY_DAYS=30

# ========================================
# Demo Accounts (seeded automatically)
# ========================================
# All demo accounts use password: password123
# - admin@example.com (admin role)
# - moderator@example.com (moderator role)
# - user@example.com (user role)
# - subscriber@example.com (subscriber role)
